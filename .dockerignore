# Secrets — never bake into an image layer. Pass at run time with --env-file.
.env
.env.bak-*
.env.example

# VCS / tooling
.git
.gitignore
.github
.claude
.venv
__pycache__
**/__pycache__
*.pyc
.mypy_cache
.pytest_cache

# Local runtime artefacts
logs/*
!logs/.gitkeep
fastembed_cache/

# Local dev TLS material (certs/local/dev-key.pem, 2026-10-04). The image needs
# only the internal CA bundle that certs/ otherwise holds; a private key must
# never enter an image layer, where it survives every later deletion.
certs/local/

# megh-full-dup (2026-11-16): secrets that live beside the code on a dev machine and are git-ignored — git-ignore
# does NOT apply to `docker build`, so without these lines they were sent to the builder and certs/voice.env (the
# Gemini key) was COPIED into the app image by `COPY certs/`. Settings reach the containers only at run time
# (docker compose env_file / environment).
certs/*.env
certs/voice.env
gateway_models.env
*.env
.env.*
**/gateway_models.env
deploy/megh-full-dup/*.env

# Docs / deploy scaffolding not needed inside the app image
docs
deploy
tests
archive
README.md
Dockerfile
docker-compose.yml
.dockerignore

# Predecessor project kept on disk for reference only
NeuralAiGovernanceProject*/
NeuralAiGovernanceProject*.zip

# React front-end source and its dependencies: the image serves the prebuilt
# web/app/ (run `npm run build` in frontend/ before building the image).
frontend
