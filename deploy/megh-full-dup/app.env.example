# MEGH-FULL-DUP — the app's settings (docker compose env_file for the `app` service).
# Docker env_file format: KEY=value on one line; NO quotes, NO comment after a value (Docker keeps it as part of the
# value). Comment lines like this one are fine. SECRET — never commit, never bake into an image.
# Only keys app/config.py knows (it refuses unknown keys). The voice keys are NOT here: compose sets VOICE_LIVE_URL,
# and the voice engine has its own voice.env.
# Hosts: Postgres megh_db, the model gateway and Qdrant are all at 10.48.242.4 — change them here if the server
# reaches them at another address.
# DECISIONS (the owner, 16 Nov 2026) — keep as they are:
#   * DATABASE_URL uses the postgres superuser on purpose (not megh_app).
#   * megh_db, the model gateway and Qdrant stay at 10.48.242.4.
#   * Sign-in is through the superadmin account (this build has its own JWT secret, so everyone signs in afresh).
#   * AI_MODEL_CA_BUNDLE_PATH points at a file that is not shipped: the gateway's TLS is not verified (as today).
PORT=8401
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=60
MODEL_MAX_CONCURRENCY=24
MODEL_QUEUE_TIMEOUT_SECONDS=20
RESPONSE_CACHE_ENABLED=false
RESPONSE_CACHE_TTL_SECONDS=900
RESPONSE_CACHE_MAX_ENTRIES=2000
SEMANTIC_CACHE_ENABLED=false
SEMANTIC_CACHE_THRESHOLD=0.93
SEMANTIC_CACHE_TTL_SECONDS=900
SEMANTIC_CACHE_MAX_ENTRIES=1000
SEMANTIC_CACHE_MIN_CHARS=12
REDIS_URL=
REDIS_CACHE_PREFIX=megh:qcache:
REDIS_SOCKET_TIMEOUT=1.5
GUIDED_DECODING_ENABLED=true
SQL_GUIDED_DECODING_ENABLED=true
SESSION_TTL_SECONDS=28800
SESSION_MAX_TURNS=50
FOLLOWUP_REWRITE_ENABLED=true
FOLLOWUP_SUGGEST_ENABLED=true
SCHEME_CLARIFY_ENABLED=true
OUT_OF_SCOPE_GUARD_ENABLED=true
AUTH_ENABLED=true
MULTITENANCY_ENABLED=true
DEFAULT_TENANT_CODE=RD
DEFAULT_TENANT_NAME=Rural Development Department
JWT_SECRET=<SET>
JWT_ISSUER=megh-full-dup
JWT_TTL_MINUTES=720
ADMIN_TOKEN=<SET>
USERS_FILE=app/users.yaml
AUDIT_FILE=logs/query_audit.jsonl
AUTH_DEFAULT_ROLE=analyst
SCHEMA_CATALOG_ENABLED=true
EMBEDDING_PROVIDER=gateway
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
DATABASE_URL=postgresql://postgres:<SET-PASSWORD>@10.48.242.4:5432/megh_db
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=4
DB_POOL_TIMEOUT=30
SQL_EXECUTION_TIMEOUT_MS=15000
SQL_MAX_RESULT_ROWS=1000
READONLY_DATABASE_URL=postgresql://megh_readonly:<SET-PASSWORD>@10.48.242.4:5432/megh_db
CHATBOT_DATABASE_URL=postgresql://megh_chatbot:<SET-PASSWORD>@10.48.242.4:5432/megh_db
CHATBOT_DB_POOL_MAX_SIZE=4
AI_MODEL_CA_BUNDLE_PATH=certs/enlight-aiops-internal-ca.pem
CLASSIFIER_MODEL=qwen4-deploy
CLASSIFIER_BASE_URL=https://10.48.242.4/openai/v1
CLASSIFIER_API_KEY=<SET>
SQL_GENERATION_MODEL=qwen-model
SQL_GENERATION_BASE_URL=https://10.48.242.4/openai/v1
SQL_GENERATION_API_KEY=<SET>
RESPONSE_MODEL=qwen35-9b
RESPONSE_MODEL_BASE_URL=https://10.48.242.4/openai/v1
REWRITE_MODEL=qwen35-9b
REWRITE_BASE_URL=https://10.48.242.4/openai/v1
REWRITE_API_KEY=
RESPONSE_MODEL_API_KEY=<SET>
SQL_VERIFY_ENABLED=true
SQL_VERIFY_MODEL=qwen-model
SQL_VERIFY_BASE_URL=https://10.48.242.4/openai/v1
SQL_VERIFY_API_KEY=
EMBEDDING_MODEL=qwen3-embedding
EMBEDDING_BASE_URL=https://10.48.242.4/openai/v1
EMBEDDING_API_KEY=<SET>
EMBED_BATCH_SIZE=32
RERANKER_MODEL=qwen3-reranker
RERANKER_BASE_URL=https://10.48.242.4/openai/v1
RERANKER_API_KEY=<SET>
ASR_MODEL=qwen3-asr
ASR_BASE_URL=https://10.48.242.4/openai/v1
ASR_API_KEY=<SET>
ASR_DEBUG_DIR=
QDRANT_URL=http://10.48.242.4:6333
QDRANT_COLLECTION=megh_knowledge
QDRANT_KB_READ_ONLY=true
SQL_EXAMPLES_COLLECTION=megh_sql_metadata
SQL_EXAMPLES_SOURCE=yaml
CONTEXT_SEMANTIC_MEMORY_ENABLED=false
CONTEXT_MEMORY_PURGE_ALSO=
RAG_HYBRID_ENABLED=false
RAG_TOP_K=12
RAG_RERANK_TOP_N=8
RAG_MIN_SCORE=0.30
RAG_HIGH_CONFIDENCE=0.84
RAG_MEDIUM_CONFIDENCE=0.35
PIPELINE_GRAPH_CHECKPOINTER_DSN=postgres
PIPELINE_GRAPH_PG_POOL_MAX=2
READONLY_DB_ALLOW_SUPERUSER=False
READONLY_DB_POOL_MAX_SIZE=4
