# MEGH-FULL-DUP — the sovereign voice's settings (docker compose env_file for `engine` and `voicesvc`).
# Docker env_file format: KEY=value, no quotes, no comment after a value. SECRET — never commit.
#   FDX_STT_*          Kyutai STT 1B (streaming ears, WebSocket on the gateway)
#   FDX_ASR_*          qwen3-asr (the words, second listen)
#   FDX_LLM_*          qwen4-deploy (the engine's short rewrites)
#   MAYA_TTS_*         maya2-native (the voice: Jahnavi = Female default, Akshat = Male)
# All at 10.48.242.4 (team GPU gateway) — change here if the server reaches it at another address.
FDX_STT_URL=wss://10.48.242.4/ws/def/kyutai-stt/api/asr-streaming
FDX_STT_API_KEY=<SET>
FDX_TLS_INSECURE=1
FDX_LLM_URL=https://10.48.242.4/openai/v1
FDX_LLM_MODEL=qwen4-deploy
FDX_LLM_INSECURE=1
FDX_LLM_TIMEOUT=8
FDX_STT_GATEWAY_KEY=<SET>
FDX_STT_GATEWAY_AUTH=header:apikey
FDX_ASR_KEY=<SET>
FDX_ASR_MODEL=qwen3-asr
FDX_LLM_KEY=<SET>
MAYA_TTS_MODEL=maya2-native
MAYA_TTS_URL=https://10.48.242.4/openai/v1/audio/speech
MAYA_TTS_API_KEY=<SET>
FDX_GATEWAY_URL=https://10.48.242.4/openai/v1
FDX_MEGH_LOG=masked
